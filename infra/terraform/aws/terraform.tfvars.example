# Copy to terraform.tfvars (gitignored) and fill in. Secrets should be supplied
# via environment variables (TF_VAR_db_password, TF_VAR_mq_password) or a secrets
# manager in CI — never commit real values.

project     = "fiapx"
environment = "dev"
region      = "us-east-1"

# Network
vpc_cidr           = "10.0.0.0/16"
az_count           = 2
single_nat_gateway = true

# EKS
eks_version         = "1.30"
node_instance_types = ["t3.large"]
node_desired_size   = 2
node_min_size       = 2
node_max_size       = 5

# RDS
db_instance_class    = "db.t3.medium"
db_engine_version    = "16.4"
db_allocated_storage = 20
db_multi_az          = false
# db_password        = "set-via-TF_VAR_db_password"

# ElastiCache
redis_node_type = "cache.t3.small"
redis_num_nodes = 1

# Amazon MQ (RabbitMQ) — password must be at least 12 characters
mq_instance_type   = "mq.t3.micro"
mq_deployment_mode = "SINGLE_INSTANCE"
# mq_password      = "set-via-TF_VAR_mq_password"

# S3 — bucket name must be globally unique
videos_bucket_name = "fiapx-videos-CHANGEME"
s3_force_destroy   = false
