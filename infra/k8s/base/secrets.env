# Development placeholder secrets (Secret fiapx-secrets). DO NOT use these values
# in a shared or production cluster — override them in a real overlay, via a
# sealed-secret / external-secrets operator, or `kubectl create secret`.
# Connection URLs live here because they embed credentials.

AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef0123456789abcdef

DATABASE_URL=postgres://fiapx:fiapx@postgres:5432/fiapx
MONGODB_URI=mongodb://fiapx:fiapx@mongo:27017/fiapx_auth?authSource=admin
RABBITMQ_URL=amqp://fiapx:fiapx@rabbitmq:5672

S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

RESEND_API_KEY=

# Credentials consumed by the in-cluster backing services
POSTGRES_PASSWORD=fiapx
MONGO_INITDB_ROOT_PASSWORD=fiapx
RABBITMQ_DEFAULT_PASS=fiapx
MINIO_ROOT_PASSWORD=minioadmin
GRAFANA_ADMIN_PASSWORD=admin
