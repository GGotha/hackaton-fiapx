# Non-secret configuration shared across services (ConfigMap fiapx-config).
# Secrets (credentials, API keys, connection URLs with passwords) live in secrets.env.

# Service ports
API_PORT=3000
AUTH_PORT=3001
WORKER_METRICS_PORT=3002
NOTIFICATION_METRICS_PORT=3003

# Redis (cache + pub/sub, no auth in-cluster)
REDIS_URL=redis://redis:6379

# S3 / MinIO — in-cluster object storage
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET_VIDEOS=fiapx-videos
S3_FORCE_PATH_STYLE=true

# Auth / JWT
# JWKS_URL is resolved server-to-server, so it uses in-cluster service DNS.
# AUTH_BASE_URL and JWT_ISSUER must match the browser-facing auth origin (the
# ingress host) because the issuer claim is validated against what clients see.
JWKS_URL=http://auth:3001/api/auth/jwks
AUTH_BASE_URL=http://auth.fiapx.local
JWT_ISSUER=http://auth.fiapx.local
JWT_AUDIENCE=fiapx
AUTH_TRUSTED_ORIGINS=http://fiapx.local

# Notifications
RESEND_FROM=FIAP X <onboarding@resend.dev>
NOTIFY_DRY_RUN=true

# Processing
FRAME_RATE=1
RABBITMQ_PREFETCH=4
MAX_VIDEO_MB=200

# In-cluster backing services (non-secret parts)
POSTGRES_USER=fiapx
POSTGRES_DB=fiapx
RABBITMQ_DEFAULT_USER=fiapx
MINIO_ROOT_USER=minioadmin
