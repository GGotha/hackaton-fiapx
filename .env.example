# Copy to .env for local development: cp .env.example .env

# ---- Postgres (video processing: api + worker) ----
POSTGRES_USER=fiapx
POSTGRES_PASSWORD=fiapx
POSTGRES_DB=fiapx
POSTGRES_PORT=5432
DATABASE_URL=postgres://fiapx:fiapx@localhost:5432/fiapx

# ---- MongoDB (auth identity) ----
MONGODB_URI=mongodb://fiapx:fiapx@localhost:27017/fiapx_auth?authSource=admin
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=fiapx
MONGO_INITDB_ROOT_PASSWORD=fiapx

# ---- Redis ----
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---- RabbitMQ ----
RABBITMQ_DEFAULT_USER=fiapx
RABBITMQ_DEFAULT_PASS=fiapx
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_URL=amqp://fiapx:fiapx@localhost:5672
RABBITMQ_PREFETCH=4

# ---- S3 / MinIO ----
S3_ENDPOINT=http://localhost:9000
# Endpoint used only to sign browser-facing download URLs; defaults to S3_ENDPOINT.
# In Docker/k8s set this to the host-reachable MinIO (http://localhost:9000).
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_VIDEOS=fiapx-videos
S3_FORCE_PATH_STYLE=true
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- Auth (better-auth) ----
AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef0123456789abcdef
AUTH_BASE_URL=http://localhost:3001
AUTH_TRUSTED_ORIGINS=http://localhost:4200
JWKS_URL=http://localhost:3001/api/auth/jwks
JWT_ISSUER=http://localhost:3001
JWT_AUDIENCE=fiapx

# ---- Email (Resend) ----
# Leave RESEND_API_KEY empty to run notifications in dry-run (logged, not sent).
RESEND_API_KEY=
RESEND_FROM="FIAP X <onboarding@resend.dev>"
NOTIFY_DRY_RUN=true

# ---- Service ports ----
API_PORT=3000
AUTH_PORT=3001
WORKER_METRICS_PORT=3002
NOTIFICATION_METRICS_PORT=3003

# ---- Monitoring ----
PROMETHEUS_PORT=9090
GRAFANA_PORT=3005

# ---- Processing ----
FRAME_RATE=1
MAX_VIDEO_MB=200
# FFMPEG_PATH=/usr/bin/ffmpeg   # optional; falls back to bundled ffmpeg-static

# ---- Frontend (Vite) ----
VITE_API_URL=http://localhost:3000
VITE_AUTH_URL=http://localhost:3001
